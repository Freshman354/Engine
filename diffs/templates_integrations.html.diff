+// Handles the redirect back from /connect/shopify/callback when this page
+// initiated the connect (return_to=integrations — see the Shopify card's
+// "Connect Shopify" button, and app.py's connect_shopify_install/callback).
+// client_id in the URL (handled above, by the existing deep-link support)
+// already makes sure the right client is selected; this just adds the
+// success/error messaging and the theme-activation banner on top.
+function handleShopifyOAuthReturn(params) {
+  if (params.get('connected') === '1') {
+    showToast('Shopify connected successfully!', 'success');
+    const activateUrl = params.get('activate_embed_url');
+    if (activateUrl) {
+      document.getElementById('activateEmbedBtn').href = activateUrl;
+      document.getElementById('activateEmbedBanner').style.display = 'flex';
+    }
+    history.replaceState({}, '', window.location.pathname + (linkedIdParam(params) ? `?client_id=${linkedIdParam(params)}` : ''));
+  } else if (params.get('error')) {
+    showToast(params.get('error'), 'error');
+    history.replaceState({}, '', window.location.pathname + (linkedIdParam(params) ? `?client_id=${linkedIdParam(params)}` : ''));
+  }
+}
+
+function linkedIdParam(params) {
+  const id = params.get('client_id');
+  return (id && CLIENTS.some(c => c.client_id === id)) ? id : null;
+}
