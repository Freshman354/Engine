+// Redirects to the OAuth install flow for the CURRENTLY SELECTED client —
+// return_to=integrations + client_id is how app.py's connect_shopify_install
+// knows to attach the connection to this specific client (verified via
+// models.verify_client_ownership) rather than "whichever client the logged
+// -in user happens to own first", which matters here since one agency user
+// can manage several.
+function connectShopifyNative(clientId) {
+  window.location.href = `/connect/shopify/install?client_id=${encodeURIComponent(clientId)}&return_to=integrations`;
+}
