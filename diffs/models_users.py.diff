+def create_or_link_shopify_user(email: str):
+    """
+    Find an existing user by email, or create a brand-new account.
+
+    Used for headless Shopify app installs — app.py's connect_shopify_callback
+    reaching here with no prior Lumvi session, because Shopify itself (not a
+    logged-in dashboard user) initiated the OAuth flow. Mirrors
+    create_or_link_google_user's shape: same email-match-or-create logic,
+    same random-unusable-password-hash trick. No id-column linking step is
+    needed here (unlike google_id) because shop identity is tracked in
+    client_integrations, not on the user — see
+    webhooks.get_client_id_by_shopify_shop for the reinstall-detection path,
+    which is checked before this function is ever called.
+
+    Shopify's shop.json doesn't always have a usable email (some dev/test
+    stores omit it) — a synthetic placeholder is used in that case so
+    account creation never blocks on it; the merchant can change it later
+    from account settings same as any other user.
+
+    Returns the user dict, or None on failure.
+    """
+    email = (email or '').strip().lower()
+    if not email:
+        email = f'shopify-{secrets.token_hex(6)}@installs.lumvi.net'
+
+    conn = cursor = None
+    try:
+        conn, cursor = get_db()
+
+        cursor.execute('SELECT * FROM users WHERE email = %s', (email,))
+        user = cursor.fetchone()
+        if user:
+            return dict(user)
+
+        random_hash = bcrypt.hashpw(
+            secrets.token_bytes(32), bcrypt.gensalt()
+        ).decode('utf-8')
+
+        cursor.execute(
+            """
+            INSERT INTO users (email, password_hash, plan_type)
+            VALUES (%s, %s, 'free')
+            RETURNING *
+            """,
+            (email, random_hash)
+        )
+        user = cursor.fetchone()
+        conn.commit()
+        return dict(user) if user else None
+
+    except Exception as e:
+        import logging
+        logging.getLogger(__name__).error(f'[create_or_link_shopify_user] {e}')
+        if conn:
+            try: conn.rollback()
+            except Exception: pass
+        return None
+    finally:
+        if cursor:
+            try: cursor.close()
+            except Exception: pass
+        if conn:
+            try: conn.close()
+            except Exception: pass
+
+
