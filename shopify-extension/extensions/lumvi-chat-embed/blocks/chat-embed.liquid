{% comment %}
  Lumvi chat widget — Theme App Embed (app embed block).

  This replaces the old copy/paste <script> snippet. It requires zero
  changes to widget.js: it resolves this shop's Lumvi client_id via
  /api/shopify/resolve-client (app.py), then creates widget.js's own
  <script data-client-id="..."> tag dynamically — exactly the shape the
  manual snippet always used. widget.js already reads data-client-id off
  whatever <script> tag created it; it has no idea (and doesn't need to
  know) that tag was created by this bootstrap instead of pasted by a
  merchant.

  {{ shop.permanent_domain }} is provided automatically by Shopify for
  every store — there is nothing for the merchant to enter here. This
  block's settings are intentionally empty; the whole point is zero
  configuration.

  If resolution fails (embed toggled on before finishing the Lumvi OAuth
  install, or after an uninstall), this fails silently — no widget,
  no error shown to the shop's visitors.

  target: "body" per Shopify's own guidance for floating/overlaid
  components — see the "App embed blocks" section of
  https://shopify.dev/docs/apps/build/online-store/theme-app-extensions/configuration,
  which names chat bubble apps as the example use case.
{% endcomment %}
<script>
  (function () {
    if (window.LumviChatbotLoaded) return;

    fetch('https://lumvi.net/api/shopify/resolve-client?shop={{ shop.permanent_domain }}')
      .then(function (r) { return r.json(); })
      .then(function (data) {
        if (!data || !data.success || !data.client_id) return;
        var s = document.createElement('script');
        s.src = 'https://lumvi.net/static/widget.js';
        s.setAttribute('data-client-id', data.client_id);
        document.body.appendChild(s);
      })
      .catch(function () {
        // Resolution failed (network error, shop not connected) — no
        // widget this page load. Nothing to surface to a storefront
        // visitor; Lumvi's own dashboard is where a merchant would
        // notice/debug a connection problem.
      });
  })();
</script>

{% schema %}
{
  "name": "Lumvi Chat",
  "target": "body",
  "settings": []
}
{% endschema %}
