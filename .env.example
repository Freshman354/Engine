# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gemini fallback provider on quota/auth errors (groq | openrouter, default: groq)
# Set to 'openrouter' to try OpenRouter before Groq when Gemini quota is exhausted
GEMINI_FALLBACK_PROVIDER=groq

# OpenRouter fallback for Gemini quota/auth failures
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-4-maverick
